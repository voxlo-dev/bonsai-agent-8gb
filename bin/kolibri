#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# kolibri-server, kolibri-pi and kolibri-studio, linked to this file: the qwen-* command of the same
# suffix with MODEL=kolibri1, whatever model.env records. Arguments pass through unchanged.
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cmd="$(basename "$0")"
case "$cmd" in
  kolibri-server | kolibri-pi | kolibri-studio) ;;
  *) echo "run this as kolibri-server, kolibri-pi or kolibri-studio" >&2; exit 1 ;;
esac
MODEL=kolibri1 exec "$ROOT/bin/qwen-${cmd#kolibri-}" "$@"
