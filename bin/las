#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# The launcher: starts a configuration (configs/NAME.env, a model plus its window, budget and
# engine) in the foreground on the engine it names, and lists the ones there are.
#   las serve [--print] [CONFIG] [-- ARGS]   llama-server, Strata or Unsloth Studio (ENGINE);
#                                            ARGS go to the engine and win over the defaults;
#                                            --print shows the command instead of running it
#   las list                                 every configuration: model, engine, window, support
#   las check CONFIG [-- ARGS]              the tool-call round-trip against the running server of
#                                            CONFIG (scripts/check_tools.py): exits 1 naming the step
#   las harness pi|opencode CONFIG [--dir DIR]
#                                            writes that harness's config for CONFIG (harness/*.py)
#                                            into DIR, default $LAS_HOME/harness/HARNESS/CONFIG;
#                                            installs no harness, touches nothing else
#   las launch pi|opencode [CONFIG] [-- ARGS]
#                                            writes that config, starts CONFIG's server in the
#                                            background unless it runs, then the harness from PATH
#                                            with ARGS; the last session leaving stops that server
# CONFIG is the argument, else the environment's, else the default install.sh recorded
# (config.env); for serve and launch without any of them, the ramp's recommendation for this RAM.
# The llama-server flags are scripts/server-flags.sh's, the Strata run config
# scripts/strata_config.py's. Needs the engine's install: ./install.sh build model.
# Rationale: docs/dev.md.
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
argv=("$@")

usage() {
  cat >&2 <<'EOF'
usage: las serve [--print] [CONFIG] [-- ARGS]
       las list
       las check CONFIG [-- ARGS]
       las harness pi|opencode CONFIG [--dir DIR]
       las launch pi|opencode [CONFIG] [-- ARGS]
EOF
  exit 1
}

cmd="${1:-}"
[[ -n "$cmd" ]] || usage
shift
# No configuration from the argument or the environment: config.env falls back to default.env.
config_given=false; [[ -n "${CONFIG:-}" ]] && config_given=true

case "$cmd" in
  serve)
    print=false
    name=""
    extra=()
    while (($#)); do
      case "$1" in
        --print) print=true ;;
        --) shift; extra=("$@"); break ;;
        -*) echo "xx unknown option '$1' - arguments for the engine go after --" >&2; exit 1 ;;
        *) [[ -z "$name" ]] || { echo "xx one CONFIG only, got '$name' and '$1'" >&2; exit 1; }
           name="$1" ;;
      esac
      shift
    done
    # A named configuration replaces the environment's, and with it the snapshot file the bench set.
    if [[ -n "$name" ]]; then export CONFIG="$name"; unset CONFIG_FILE; fi
    ;;
  list) ;;
  check)
    name="${1:-}"
    [[ -n "$name" && "$name" != -* ]] || usage
    shift
    [[ $# -eq 0 || "$1" == -- ]] || usage
    shift || true
    export CONFIG="$name"; unset CONFIG_FILE
    ;;
  harness)
    harness="${1:-}"; name="${2:-}"; dir=""
    case "$harness" in pi | opencode) ;; *) usage ;; esac
    [[ -n "$name" && "$name" != -* ]] || usage
    shift 2
    while (($#)); do
      case "$1" in
        --dir) [[ $# -ge 2 ]] || usage; dir="$2"; shift ;;
        *) usage ;;
      esac
      shift
    done
    export CONFIG="$name"; unset CONFIG_FILE
    ;;
  launch)
    harness="${1:-}"; name=""; extra=(); print=false; dir=""
    case "$harness" in pi | opencode) shift ;; *) usage ;; esac
    if (($#)) && [[ "$1" != -- ]]; then name="$1"; shift; fi
    if (($#)); then [[ "$1" == -- ]] || usage; shift; extra=("$@"); fi
    if [[ -n "$name" ]]; then export CONFIG="$name"; unset CONFIG_FILE; fi
    ;;
  *) usage ;;
esac
[[ -n "${name:-}" ]] && config_given=true

source "$ROOT/scripts/lib.sh"

# Neither named nor recorded by install.sh: the configuration the ramp recommends for this RAM,
# instead of config.env's fixed fallback. Runs las again, since config.env is sourced only once.
if [[ "$cmd" == serve || "$cmd" == launch ]] && ! $config_given && [[ ! -f "$LAS_HOME/default.env" ]]; then
  rec="$(recommended_config "$(mem_total_mb)")"
  if [[ -n "$rec" && "$rec" != "$CONFIG" ]]; then
    log "no configuration named and none recorded in $LAS_HOME/default.env: $rec, the ramp's pick for this RAM" >&2
    CONFIG="$rec" exec "$0" "${argv[@]}"
  fi
fi

# Execs the command, or with --print shows it: one line, quoted so it can be pasted.
run() {
  if $print; then
    printf '%q' "$1"; shift
    printf ' %q' "$@"
    printf '\n'
    exit 0
  fi
  exec "$@"
}

# Preconditions of the llama.cpp engines; --print needs none, it only shows the command.
need_build() {
  if $print; then return 0; fi
  [[ -x "$LLAMA_SERVER" ]] || die "llama-server not found at $LLAMA_SERVER - run CONFIG=$CONFIG ./install.sh build"
  [[ -f "$MODEL_PATH" ]] || die "model not found at $MODEL_PATH - run CONFIG=$CONFIG ./install.sh model"
}

serve_llama() {
  need_build
  [[ "$VISION" == 0 || -f "$MMPROJ_PATH" || $print == true ]] \
    || die "vision projector not found at $MMPROJ_PATH - run VISION=1 CONFIG=$CONFIG ./install.sh model"
  source "$ROOT/scripts/server-flags.sh"
  local args=(-m "$MODEL_PATH"
    --host "$LISTEN_HOST" --port "$PORT" --alias "$MODEL_ALIAS"
    -c "$CTX" "${LOAD_FLAGS[@]}" --parallel 1)
  if [[ -n "$SPEC_TYPE" ]]; then args+=(--spec-type "$SPEC_TYPE"); fi
  args+=(--temp "$SAMPLING_TEMP" --top-p "$SAMPLING_TOP_P" --top-k "$SAMPLING_TOP_K" --min-p "$SAMPLING_MIN_P")
  run "$LLAMA_SERVER" "${args[@]}" "${extra[@]}"
}

# Strata serves the run config `strata launch` wrote, prepared by scripts/strata_config.py with
# its approximations on, as Strata ships them; the bench prepares the same file with them off.
serve_strata() {
  local out="$LAS_HOME/strata/$CONFIG.json" prepared
  prepared="$(env STRATA_BIN="$STRATA_BIN" STRATA_VERSION="$STRATA_VERSION" STRATA_CONFIG="$STRATA_CONFIG" \
    STRATA_OVERRIDES="$STRATA_OVERRIDES" CTX="$CTX" MODEL_ALIAS="$MODEL_ALIAS" LISTEN_HOST="$LISTEN_HOST" \
    SERVER_HOST="$SERVER_HOST" PORT="$PORT" python3 "$ROOT/scripts/strata_config.py" prepare "$out")" \
    || die "no Strata run config for $CONFIG - see docs/bench.md and bench/README.md#strata"
  run "$STRATA_BIN" serve --profile "$prepared" --host "$LISTEN_HOST" --port "$PORT" "${extra[@]}"
}

# Unsloth Studio on this repo's llama-server, with the same flags. Studio takes the window, the
# drafting and the sampling as options of its own, and the rest of LOAD_FLAGS passes through to its
# llama-server, where it wins over what Studio picks itself. Rationale: docs/agent.md#unsloth-studio.
serve_studio() {
  VISION=0  # Studio takes no --mmproj, see --no-mmproj below
  source "$ROOT/scripts/server-flags.sh"
  local cli="$UNSLOTH_CLI"
  [[ -x "$cli" ]] || cli="$(command -v unsloth || true)"
  [[ -n "$cli" ]] || $print || die "Unsloth Studio's unsloth command not found at $UNSLOTH_CLI or on PATH - install Studio (https://github.com/unslothai/unsloth) or set UNSLOTH_CLI"
  need_build

  # Studio drafts on its own when it finds an MTP head; SPEC_TYPE decides instead.
  local spec
  case "$SPEC_TYPE" in
    draft-mtp) spec=mtp ;;
    "" | none) spec=off ;;
    *) die "SPEC_TYPE=$SPEC_TYPE has no Unsloth Studio equivalent here (draft-mtp or none)" ;;
  esac

  # Studio refuses a top-k above 100; Kolibri-1's card asks for 128. Clamped, since its top-p of
  # 0.97 leaves ranks past 100 almost no mass (docs/kolibri1.md#settings).
  local top_k="$SAMPLING_TOP_K"
  ((top_k <= 100)) || top_k=100

  # Studio's default memory mode, auto, keeps an explicitly requested window and appends the flags
  # below after its own, so the configuration's placement wins (--fit off, every layer on the card,
  # the experts of CPU_MOE layers in RAM). Its manual mode would strip them and has no option for
  # the expert count. One slot: Studio's default of 4 splits CTX.
  local args=(studio run --model "$MODEL_PATH" --context-length "$CTX"
    --parallel 1 --speculative-type "$spec"
    --temperature "$SAMPLING_TEMP" --top-p "$SAMPLING_TOP_P" --top-k "$top_k" --min-p "$SAMPLING_MIN_P"
    "${LOAD_FLAGS[@]}"
    # Studio picks a vision projector from beside the GGUF itself, where it may find another model's,
    # and refuses --mmproj, so VISION does not reach it: text only. See docs/agent.md#unsloth-studio.
    --no-mmproj
    # Studio reads the model into memory (--load-mode none) when it estimates it fits; the experts
    # in RAM are measured mmapped, through the page cache. auto is llama.cpp's default: mmap.
    --load-mode auto
    "${extra[@]}")
  export LLAMA_SERVER_PATH="$LLAMA_SERVER"
  if $print; then printf 'LLAMA_SERVER_PATH=%q ' "$LLAMA_SERVER_PATH"; fi
  run "${cli:-unsloth}" "${args[@]}"
}

# One row per configs/*.env, each read the way `las serve` would: name, model, engine, window,
# and whether its model is supported (models/*.env MODEL_SUPPORT).
list_configs() {
  local f n
  printf '%-34s %-14s %-7s %7s  %s\n' CONFIG MODEL ENGINE WINDOW SUPPORT
  for f in "$ROOT"/configs/*.env; do
    n="$(basename "$f" .env)"
    (
      export CONFIG="$n"
      unset CONFIG_FILE ENGINE CTX MODEL
      source "$ROOT/config.env"
      printf '%-34s %-14s %-7s %6sk  %s\n' "$n" "$MODEL" "$ENGINE" "$((CTX / 1024))" "$MODEL_SUPPORT"
    ) || warn "configs/$n.env does not resolve"
  done
}

# The harness's config for the configuration, and the line that starts the harness with it.
write_harness() {
  dir="${dir:-$LAS_HOME/harness/$harness/$CONFIG}"
  env SERVER_URL="$SERVER_URL" MODEL_ALIAS="$MODEL_ALIAS" CTX="$CTX" MAX_TOKENS="$MAX_TOKENS" VISION="$VISION" \
    RESERVE_TOKENS="$RESERVE_TOKENS" KEEP_RECENT_TOKENS="$KEEP_RECENT_TOKENS" \
    PI_BG_BASH_VERSION="$PI_BG_BASH_VERSION" PI_BG_BASH_SHA256="$PI_BG_BASH_SHA256" \
    PI_BG_BASH_URL="${PI_BG_BASH_URL:-}" LAS_HOME="$LAS_HOME" python3 "$ROOT/harness/$harness.py" "$dir" >/dev/null || die "could not write the $harness config into $dir"
  log "wrote the $harness config for $CONFIG into $dir"
  case "$harness" in
    pi) log "start it: PI_CODING_AGENT_DIR=$dir pi" ;;
    opencode) log "start it: OPENCODE_CONFIG=$dir/opencode.json opencode" ;;
  esac
}

# The round-trip against the server CONFIG names; it must already run (las serve CONFIG).
check_tools() {
  SERVER_URL="$SERVER_URL" MODEL_ALIAS="$MODEL_ALIAS" exec python3 "$ROOT/scripts/check_tools.py" "$@"
}

# The harness with its config written fresh, on CONFIG's server: reused when one runs, else started
# in the background here. Sessions register under $LAS_HOME/run behind a lock, so a second launch
# shares the server and only the last to leave stops it, and only a server launch started; one
# whose session died without its trap is adopted by the next. See docs/agent.md#server-lifecycle.
launch() {
  local bin run pid models served i status=0
  case "$harness" in pi) bin=pi ;; opencode) bin=opencode ;; esac
  has "$bin" || die "$bin not found on PATH - install it yourself (README.md#harnesses); las installs no harness"
  [[ "$ENGINE" != studio ]] || die "$CONFIG runs in Unsloth Studio, which serves on its own port behind its own login - launch a llama or Strata configuration"
  write_harness >/dev/null
  # Ready means the engine lists its models, Strata and llama-server alike.
  healthy() { curl -sf -o /dev/null --max-time 2 "$SERVER_URL/v1/models"; }
  alive() { [[ -n "${1:-}" ]] && kill -0 "$1" 2>/dev/null; }
  run="$LAS_HOME/run"
  mkdir -p "$run/sessions"
  exec 9>"$run/lock"
  # Sessions whose process is gone (SIGKILL, a terminal closed hard) never ran their trap.
  prune() { local f; for f in "$run/sessions"/*; do [[ -e "$f" ]] && ! alive "${f##*/}" && rm -f "$f"; done; return 0; }
  leave() {
    flock 9
    rm -f "$run/sessions/$$"
    prune
    local pid; pid="$(cat "$run/server.pid" 2>/dev/null || true)"
    if [[ -z "$(ls -A "$run/sessions")" ]] && alive "$pid"; then
      log "stopping the server of $(cat "$run/server.config" 2>/dev/null || echo "$CONFIG")" >&2
      kill -- "-$pid" 2>/dev/null || kill "$pid"
      for _ in {1..40}; do alive "$pid" || break; sleep 0.5; done
      alive "$pid" && kill -9 -- "-$pid" 2>/dev/null
    fi
    alive "$pid" || rm -f "$run/server.pid" "$run/server.config"
    flock -u 9
  }
  flock 9
  prune
  touch "$run/sessions/$$"
  trap leave EXIT
  trap 'exit 129' HUP
  trap 'exit 143' TERM
  trap 'exit 130' INT
  pid="$(cat "$run/server.pid" 2>/dev/null || true)"
  if ! healthy && ! alive "$pid"; then
    case "$SERVER_HOST" in
      127.0.0.1 | ::1 | localhost) ;;
      *) flock -u 9; die "no server at $SERVER_URL - SERVER_HOST is another machine, start las serve $CONFIG there" ;;
    esac
    log "starting $CONFIG in the background, log: $SERVER_LOG" >&2
    # Its own session: Ctrl+C in the harness must not reach the engine, and stopping it reaches
    # every process the engine started (Strata's vision process too).
    setsid env CONFIG="$CONFIG" "$ROOT/bin/las" serve >"$SERVER_LOG" 2>&1 </dev/null 9>&- &
    pid=$!
    echo "$pid" >"$run/server.pid"
    echo "$CONFIG" >"$run/server.config"
  fi
  flock -u 9
  if ! healthy; then
    log "waiting for the model to load (up to SERVER_START_TIMEOUT, ${SERVER_START_TIMEOUT}s)" >&2
    for ((i = 0; i < SERVER_START_TIMEOUT; i++)); do
      healthy && break
      if ! alive "$pid"; then
        warn "the server exited during start - last lines of $SERVER_LOG:"
        tail -20 "$SERVER_LOG" >&2 || true
        die "see docs/setup.md#troubleshooting"
      fi
      sleep 1
    done
    healthy || die "the server is not ready after ${SERVER_START_TIMEOUT}s - raise SERVER_START_TIMEOUT, its log is $SERVER_LOG"
  fi
  # The server on PORT may be another configuration's: the harness would talk to the wrong model.
  models="$(curl -sf --max-time 5 "$SERVER_URL/v1/models" || true)"
  if ! grep -q "\"$MODEL_ALIAS\"" <<<"$models"; then
    served="$(grep -o '"id" *: *"[^"]*"' <<<"$models" | head -1 | sed 's/.*"\([^"]*\)"$/\1/' || true)"
    die "the server at $SERVER_URL serves ${served:-another model}, not $MODEL_ALIAS ($CONFIG) - stop it first, or give one of them another PORT"
  fi
  # The harness handles Ctrl+C itself; caught here, bash resets it for the child and keeps the trap.
  trap : INT
  case "$harness" in
    pi) PI_CODING_AGENT_DIR="$dir" pi "${extra[@]}" 9>&- || status=$? ;;
    opencode) OPENCODE_CONFIG="$dir/opencode.json" opencode "${extra[@]}" 9>&- || status=$? ;;
  esac
  exit "$status"
}

case "$cmd" in
  list) list_configs ;;
  check) check_tools "$@" ;;
  harness) write_harness ;;
  launch) launch ;;
  serve)
    case "$ENGINE" in
      llama) serve_llama ;;
      strata) serve_strata ;;
      studio) serve_studio ;;
    esac ;;
esac
