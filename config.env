# SPDX-License-Identifier: MIT
# Settings shared by the install steps, `las` and the bench. A variable already set in the
# environment wins, then configs/$CONFIG.env, then models/$MODEL.env, then the defaults here.

# Install location: builds, models and the data of every run, ~120 GB with all models.
: "${LAS_HOME:=$HOME/.local/share/local-agent-suite}"

# The configuration: a model plus its window, budget and engine (configs/*.env). The environment
# wins, then the default install.sh recorded in $LAS_HOME/default.env, then CONFIG_DEFAULT (for
# `las serve` and `las launch`, the ramp's pick for this RAM, scripts/lib.sh). It sets
# MODEL, the model file in models/ that pins the GGUF, the llama.cpp tree that runs it and the
# flags that differ between models. CTX and the four budget values constrain each other - see
# docs/agent.md#context-budget - which is why a configuration sets them together. See README.md.
CONFIG_DEFAULT=qwen36-35b
_root="$(dirname "${BASH_SOURCE[0]}")"
if [ -z "${CONFIG:-}" ] && [ -f "$LAS_HOME/default.env" ]; then . "$LAS_HOME/default.env"; fi
: "${CONFIG:=$CONFIG_DEFAULT}"
# CONFIG_FILE names a copy of the configuration file to read instead: the bench's snapshot of one.
: "${CONFIG_FILE:=$_root/configs/$CONFIG.env}"
[ -f "$CONFIG_FILE" ] || { echo "unknown CONFIG '$CONFIG' - no $CONFIG_FILE, see configs/" >&2; return 1 2>/dev/null || exit 1; }
. "$CONFIG_FILE"
[ -f "$_root/models/$MODEL.env" ] || { echo "unknown MODEL '$MODEL' in configs/$CONFIG.env - see models/" >&2; return 1 2>/dev/null || exit 1; }

# Engine the configuration runs on: llama (llama-server), strata (Strata serving its run config) or
# studio (Unsloth Studio on this repo's llama-server). See bench/README.md#strata.
: "${ENGINE:=llama}"
case "$ENGINE" in llama|strata|studio) ;; *) echo "unknown ENGINE '$ENGINE' (llama, strata, studio)" >&2; return 1 2>/dev/null || exit 1 ;; esac

# GPU backend: "cuda" (NVIDIA, the measured default) or "vulkan" (AMD through RADV, ~5x slower,
# for batch use). It selects the toolchain deps installs, the flags build passes and the patches
# the model file names (PATCH_DIR, patches/$BACKEND for the fork). Switch with BACKEND=vulkan
# ./install.sh; build rebuilds by itself when the backend or the patch set changes. See
# docs/bonsai.md#other-gpu-backends.
: "${BACKEND:=cuda}"
case "$BACKEND" in cuda|vulkan) ;; *) echo "unknown BACKEND '$BACKEND' (cuda, vulkan)" >&2; return 1 2>/dev/null || exit 1 ;; esac

. "$_root/models/$MODEL.env"
# Whether the model is offered by install.sh and recommended by preflight: only a model a bench run
# has measured. An unsupported one runs and benches like any other.
: "${MODEL_SUPPORT:=unsupported}"
case "$MODEL_SUPPORT" in supported|unsupported) ;; *) echo "unknown MODEL_SUPPORT '$MODEL_SUPPORT' (supported, unsupported)" >&2; return 1 2>/dev/null || exit 1 ;; esac
# The ramp install.sh offers and preflight recommends from, by the RAM next to the card
# (README.md#which-model): RAMP the smallest first, the recommendation the largest that fits;
# RAMP_ALSO offered beside it, never recommended. A configuration of an unsupported model is left out.
: "${RAMP:=lfm25-24b qwen36-35b qwen38-flash-gsq-iq3xxs-strata}"
: "${RAMP_ALSO:=ornith-35b flint qwen38-flash-strata-dflash2 qwen38-flash}"
LLAMA_SERVER="$LLAMA_DIR/build/bin/llama-server"
# A tree whose commit cannot be fetched comes as a release tarball instead: LLAMA_TARBALL is its
# URL, LLAMA_TARBALL_SHA256 the pin build checks it against. Only Unsloth's, the Qwen tree on CUDA.
: "${LLAMA_TARBALL:=}"
: "${LLAMA_TARBALL_SHA256:=}"
# Further cmake flags the tree needs, word-split, set by the model file. Part of the build stamp, so
# a change rebuilds. None today; Unsloth's b11160 pin fetched CCCL 3.2 (docs/qwen38-flash.md, T-049).
: "${LLAMA_CMAKE_ARGS:=}"
MODEL_PATH="$LAS_HOME/models/$MODEL_FILE"
# A chat template file a model needs in place of the GGUF's own: a path under templates/, passed to
# llama-server. Empty means the GGUF's template.
: "${CHAT_TEMPLATE:=}"
CHAT_TEMPLATE_PATH="${CHAT_TEMPLATE:+$_root/$CHAT_TEMPLATE}"
# Set by a MoE model's configuration only; empty means the flag is not passed. See bin/las.
: "${CPU_MOE:=}"
: "${UB:=}"
# Vision: the model's projector loaded on the CPU next to it, so a harness's read tool can show the model a
# screenshot. Costs no VRAM, ~1 GB of RAM, and ~10 s on the CPU per 1280x800 image, which becomes
# up to IMAGE_MAX_TOKENS tokens of the window. Empty means on once the projector is installed
# (VISION=1 ./install.sh model), 1 requires it, 0 turns it off; the model file pins it
# (MMPROJ_*). Strata brings its own projector: there empty means on when its run config serves
# images (--vision), and VISION only tells the harness. See docs/agent.md#vision.
: "${VISION:=}"
: "${IMAGE_MAX_TOKENS:=512}"
MMPROJ_PATH="$LAS_HOME/models/mmproj-$MODEL.gguf"
# Empty for a text-only model: no projector to pin.
: "${MMPROJ_FILE:=}"
case "$VISION" in
  "") VISION=0
    if [ "$ENGINE" = strata ]; then
      if [ -f "${STRATA_CONFIG:-}" ] && grep -q '"--vision"' "$STRATA_CONFIG"; then VISION=1; fi
    elif [ -f "$MMPROJ_PATH" ]; then VISION=1; fi ;;
  0|1) ;;
  *) echo "unknown VISION '$VISION' (1, 0, or empty)" >&2; return 1 2>/dev/null || exit 1 ;;
esac
if [ "$VISION" = 1 ] && [ "$ENGINE" != strata ] && [ -z "$MMPROJ_FILE" ]; then
  echo "MODEL=$MODEL has no vision projector - unset VISION, or pick another model" >&2; return 1 2>/dev/null || exit 1
fi
# Further llama-server flags a model file needs and no setting above covers, word-split. Empty for
# Bonsai and Qwen3.6; Qwen3.8-Flash keeps its experts file-backed with them. See its model file.
: "${SERVER_ARGS:=}"

# CUDA architecture to compile for, e.g. 89 for an RTX 40xx. Empty means the card nvidia-smi
# reports, or cmake's "native" without one; set it to build where the card is not visible.
: "${CUDA_ARCH:=}"

# Parallel compile jobs. Empty means derive them: one per core, but capped so each job has
# ~2 GB, because a single Vulkan shader unit peaks at 4.4 GB and -j nproc can put several
# heavy ones side by side. Set a number to override. See docs/setup.md#ram-and-build-memory.
: "${BUILD_JOBS:=}"

# pi as the bench measures it: pinned version, installed in the bench image. The context budget is
# computed from this version's compaction trigger and output clamp.
: "${PI_VERSION:=1.4.0}"
# pi-bg-bash, the extension that gives pi's bash a `background` flag and moves a command still
# running after 120 s to the background. Pinned by its npm tarball. See docs/agent.md#background-tasks.
: "${PI_BG_BASH_VERSION:=0.2.0}"
: "${PI_BG_BASH_SHA256:=61b786c120273ef3b9d03676eb43f732d30e252fec94f0318cf4c0763b73004c}"

# The bench image every attempt runs in: built by bench/image.sh from this base, pinned by digest,
# with pi at PI_VERSION. See bench/README.md.
: "${BENCH_IMAGE:=localhost/qwen-bench}"
: "${BENCH_BASE_IMAGE:=docker.io/library/node:24-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205}"
# A bench configuration fits when, after one prompt filling CTX - RESERVE_TOKENS, the card still
# has this much free: the CUDA pool grows outside the reserved buffers. See bench/README.md#fit-check.
: "${BENCH_VRAM_MARGIN_MB:=200}"
# Strata, the engine of ENGINE=strata: the installed STRATA_VERSION serving the run config
# STRATA_CONFIG that `strata launch` wrote; STRATA_OVERRIDES (a JSON object) puts keys of that
# config back. See bench/README.md#strata.
: "${STRATA_BIN:=strata}"
: "${STRATA_VERSION:=0.2.10}"
: "${STRATA_CONFIG:=}"
: "${STRATA_OVERRIDES:=}"

: "${SERVER_LOG:=$LAS_HOME/server.log}"
: "${SERVER_START_TIMEOUT:=300}"

# ENGINE=studio opens the same model and flags in Unsloth Studio through its `unsloth`
# command (las serve). Studio serves on its own port (8888), with its own login. See docs/agent.md#unsloth-studio.
: "${UNSLOTH_CLI:=$HOME/.unsloth/studio/unsloth_studio/bin/unsloth}"

# Server. LISTEN_HOST is the address the server binds to, SERVER_HOST the one a harness
# connects to: the same machine by default, different ones when the server runs elsewhere. A
# remote server needs LISTEN_HOST=0.0.0.0 on its side and has no authentication - see
# docs/agent.md#a-server-on-another-machine. A harness config written from them keeps its own copy.
: "${LISTEN_HOST:=127.0.0.1}"
: "${SERVER_HOST:=127.0.0.1}"
: "${PORT:=8080}"
SERVER_URL="http://$SERVER_HOST:$PORT"
# BUDGET_MSG closes a thinking block cut off at BUDGET. One step, not "the files": in the T-019
# Tron run the orchestrator read "write the files" as leave to write a test file next to its plan.
_budget_msg=$'\n\nThinking budget reached. Stop planning and act now: make your next tool call.\n'
: "${BUDGET_MSG:=$_budget_msg}"

# Drop the thinking of earlier turns from the rendered prompt; the current turn keeps its own.
# The template preserves all of it unless told otherwise. See docs/bonsai.md#thinking-in-the-prompt.
: "${PRESERVE_THINKING:=false}"

# CTX, BUDGET, MAX_TOKENS, RESERVE_TOKENS and KEEP_RECENT_TOKENS come from the configuration.
# They must satisfy:
#   RESERVE_TOKENS >= the largest single turn's output, and CTX - RESERVE_TOKENS + MAX_TOKENS <= CTX
#   KEEP_RECENT_TOKENS well below CTX - RESERVE_TOKENS, or pi compacts on every turn.
#   BUDGET + a tool call <= RESERVE_TOKENS - 4096: pi clamps max_tokens by that near the trigger.
# Rationale and measurements: docs/agent.md#context-budget.
