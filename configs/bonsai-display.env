# SPDX-License-Identifier: MIT
# Bonsai with the GPU also rendering a desktop, which takes 0.5-1.2 GB.
# 48k window and the smaller budget that fits its trigger, verified in the T-012 run.
# Expect lower generation speed while a browser or window renders on the same GPU.
: "${MODEL:=bonsai}"
: "${CTX:=48000}"
: "${BUDGET:=4096}"
: "${MAX_TOKENS:=12000}"
: "${RESERVE_TOKENS:=12000}"
: "${KEEP_RECENT_TOKENS:=8000}"
