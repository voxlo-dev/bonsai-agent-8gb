# SPDX-License-Identifier: MIT
# Bonsai as models/bonsai.env sets it, the GPU driving no display so all 8 GB are available.
# 64k window, measured at 7 755 MiB of 8 188, 7 779 at most through a 60 000-token prompt. See docs/agent.md#context-budget.
: "${MODEL:=bonsai}"
: "${CTX:=64000}"
: "${BUDGET:=8192}"
: "${MAX_TOKENS:=16000}"
: "${RESERVE_TOKENS:=16000}"
: "${KEEP_RECENT_TOKENS:=12000}"
# The bench fill leaves 30 MiB free, the driver's ~380 MiB reserve not counted, and its VRAM is
# flat over depth (+24 MiB to a 60k fill, docs/bonsai.md): the 200 MiB margin for pool growth is
# not needed, and the cache types that would free more crash this pin (K at q4_0, T-090).
: "${BENCH_VRAM_MARGIN_MB:=25}"
