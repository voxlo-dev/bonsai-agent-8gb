# SPDX-License-Identifier: MIT
# Gemma-4-26B-A4B, the GPU driving no display: Qwen3.6's window and budget at q8_0/q8_0, ubatch
# 2048, the MTP assistant drafting, with the experts of 27 of 30 layers in RAM. Optimized by
# bench-optimize to stage 2 (run gemma4-opt-speed): 26 leaves 112 MiB after the fill, and ubatch
# 1024 at 26 reads prompts a third slower for no decode gain.
: "${MODEL:=gemma4-26b}"
: "${CTX:=131072}"
: "${CPU_MOE:=27}"
: "${UB:=2048}"
: "${BUDGET:=16384}"
: "${MAX_TOKENS:=32000}"
: "${RESERVE_TOKENS:=32000}"
: "${KEEP_RECENT_TOKENS:=24000}"
