# SPDX-License-Identifier: MIT
# Kolibri-1 with the GPU also rendering a desktop, which takes 0.5-1.2 GB.
# The kolibri1 configuration as is: with every expert in RAM it leaves ~2.5 GB by arithmetic. Not
# measured with a desktop on the card. See docs/kolibri1.md#window-and-profiles.
: "${MODEL:=kolibri1}"
: "${CTX:=131072}"
: "${CPU_MOE:=50}"
: "${UB:=2048}"
: "${BUDGET:=16384}"
: "${MAX_TOKENS:=32000}"
: "${RESERVE_TOKENS:=32000}"
: "${KEEP_RECENT_TOKENS:=24000}"
