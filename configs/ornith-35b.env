# SPDX-License-Identifier: MIT
# Ornith-1.5-35B-A3B, the GPU driving no display: Qwen3.6's window and budget at q8_0/q8_0, ubatch
# 2048, MTP on, with the experts of 37 of 40 layers in RAM. Optimized by bench-optimize to stage 2
# (runs ornith-opt-speed, -speed2): 36 left 58 MiB after the fill, ubatch 1024 reads prompts ~1.5x slower.
: "${MODEL:=ornith-35b}"
: "${CTX:=131072}"
: "${CPU_MOE:=37}"
: "${UB:=2048}"
: "${BUDGET:=16384}"
: "${MAX_TOKENS:=32000}"
: "${RESERVE_TOKENS:=32000}"
: "${KEEP_RECENT_TOKENS:=24000}"
