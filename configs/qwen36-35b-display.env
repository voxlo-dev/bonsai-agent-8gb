# SPDX-License-Identifier: MIT
# Qwen3.6-35B-A3B with the GPU also rendering a desktop, which takes 0.5-1.2 GB.
# The qwen36-35b window with every expert in RAM: ~6 430 MiB by arithmetic (one expert layer is
# ~470 MiB), which leaves ~1 GB. Not measured with a desktop on the card. See docs/qwen36.md.
: "${MODEL:=qwen36-35b}"
# UD-Q4_K_M, the quant it was measured with; the model file pins UD-Q4_K_XL.
: "${MODEL_FILE:=Qwen3.6-35B-A3B-UD-Q4_K_M.gguf}"
: "${MODEL_SHA256:=0b21525e972670ed59e1812e170b27c26355381f0656ecc4e25617ece7dac58b}"
: "${MODEL_DISK_MB:=21700}"
: "${MODEL_RAM_MB:=24000}"
: "${CTX:=131072}"
: "${CPU_MOE:=40}"
: "${UB:=2048}"
: "${BUDGET:=16384}"
: "${MAX_TOKENS:=32000}"
: "${RESERVE_TOKENS:=32000}"
: "${KEEP_RECENT_TOKENS:=24000}"
