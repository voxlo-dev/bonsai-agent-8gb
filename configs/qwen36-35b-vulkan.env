# SPDX-License-Identifier: MIT
# Qwen3.6-35B-A3B on BACKEND=vulkan: the qwen36-35b configuration with every expert in RAM. On the
# RX 570 nine expert layers on the card bought 9 % and more bought nothing, and at 131k this leaves
# ~2 GB of VRAM free (6 026 MiB used). The window stays at 131k: measured at 22.4-22.8 tok/s on each
# of three requests on one cache. See docs/qwen36.md#on-the-rx-570-vulkan.
: "${BACKEND:=vulkan}"
: "${MODEL:=qwen36-35b}"
: "${CTX:=131072}"
: "${CPU_MOE:=40}"
: "${UB:=2048}"
: "${BUDGET:=16384}"
: "${MAX_TOKENS:=32000}"
: "${RESERVE_TOKENS:=32000}"
: "${KEEP_RECENT_TOKENS:=24000}"
