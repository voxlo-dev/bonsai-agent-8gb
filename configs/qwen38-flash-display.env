# SPDX-License-Identifier: MIT
# Qwen3.8-Flash-Next with the GPU also rendering a desktop, which takes 0.5-1.2 GB.
# Half the qwen38-flash window: 6 052 MiB of buffers, which leaves ~1.6 GB for the desktop. Not
# measured with a desktop on the card. See docs/qwen38-flash.md.
: "${MODEL:=qwen38-flash}"
: "${CTX:=65536}"
: "${CPU_MOE:=48}"
: "${UB:=512}"
: "${BUDGET:=8192}"
: "${MAX_TOKENS:=16000}"
: "${RESERVE_TOKENS:=16000}"
: "${KEEP_RECENT_TOKENS:=12000}"
