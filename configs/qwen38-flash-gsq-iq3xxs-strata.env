# SPDX-License-Identifier: MIT
# Qwen3.8-Flash GSQ-RCO IQ3_XXS (ISTA-DASLab) on Strata 0.2.10 with DFlash2 alone, at 262k.
# Optimized by bench-optimize to stage 4 (docs/bench.md#qwen38-flash-gsq-rco-iq3_xxs-optimized):
# the preset "IQ3_XXS 256K" `strata launch --tune quick` wrote on 2026-11-04 (int8 KV, 20k KV
# resident, defaults confirmed), against the same preset at 131k.
: "${ENGINE:=strata}"
: "${STRATA_CONFIG:=$HOME/.local/state/strata/launch/iq3_xxs-256k.json}"
# Its run config lacks the preset's drafter, so `strata serve --profile` would draft with MTP.
_overrides='{"drafting": "dflash2"}'
: "${STRATA_OVERRIDES:=$_overrides}"
# Only the window moves: the reserve, output and keep values bound a turn, not the window, so the
# qwen38-flash values still meet docs/agent.md#context-budget at 262k.
: "${CTX:=262144}"
# The preset waited 946 s for the engine at 131k.
: "${SERVER_START_TIMEOUT:=1200}"
: "${MODEL:=qwen38-flash}"
# How the ramp lists it (README.md#which-model). Strata keeps its experts resident in RAM, so the
# model file's page-cache threshold does not apply.
: "${MODEL_TITLE:=Qwen3.8-Flash IQ3_XXS, Strata}"
: "${MODEL_ROLE:=the strongest fast one, ~40 tok/s}"
: "${MODEL_RAM_FULL_MB:=0}"
: "${CPU_MOE:=48}"
: "${UB:=512}"
: "${BUDGET:=8192}"
: "${MAX_TOKENS:=32000}"
: "${RESERVE_TOKENS:=32000}"
: "${KEEP_RECENT_TOKENS:=24000}"
