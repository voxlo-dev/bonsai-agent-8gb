# SPDX-License-Identifier: MIT
# Qwen3.8-Flash UD-IQ4_XS on Strata 0.2.10 with the DFlash2 drafter alone ("drafting": "dflash2",
# so a start that cannot draft with it fails instead of falling back to MTP). The preset
# "UD-IQ4_XS 128K Flash2" `strata launch --tune quick` wrote on 2026-11-03 (131k, int8 KV, 32k KV
# resident, 35 GiB resident), with the qwen38-flash window and budget. The 0.2.9 preset no
# longer starts on 0.2.10.
: "${ENGINE:=strata}"
: "${STRATA_CONFIG:=$HOME/.local/state/strata/launch/ud-iq4_xs-128k-flash2.json}"
# Pinning the resident budget reads the experts from disk first; the preset waits up to 1089 s.
: "${SERVER_START_TIMEOUT:=1200}"
: "${MODEL:=qwen38-flash}"
# How the ramp lists it (README.md#which-model). Strata keeps its experts resident in RAM, so the
# model file's page-cache threshold does not apply.
: "${MODEL_TITLE:=Qwen3.8-Flash UD-IQ4_XS, Strata}"
: "${MODEL_ROLE:=best quality, ~30 tok/s}"
: "${MODEL_RAM_FULL_MB:=0}"
: "${CTX:=131072}"
: "${CPU_MOE:=48}"
: "${UB:=512}"
: "${BUDGET:=8192}"
: "${MAX_TOKENS:=32000}"
: "${RESERVE_TOKENS:=32000}"
: "${KEEP_RECENT_TOKENS:=24000}"
