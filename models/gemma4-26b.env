# SPDX-License-Identifier: MIT
# Gemma-4-26B-A4B-it, Google's MoE (architecture gemma4: 30 layers, 128 experts with 8 active, ~4B
# per token), QAT weights. Five of every six layers attend over a 1024-token sliding window, so only
# 5 hold a full-window cache. The experts of CPU_MOE layers in system RAM, the rest on the card; a
# separate MTP assistant drafts. A tier-2 candidate (T-082), not yet benched.
# Sourced by config.env after the configuration, so a configuration value wins over the defaults here.

# On CUDA Unsloth's tree, already built for both Qwen models: it knows gemma4, its assistant drafter
# (gemma4-assistant) and parses Gemma 4's tool calls (common/parsers/gemma4.cpp): `las check
# gemma4-26b` passes with the GGUF's template. Not measured on Vulkan.
. "$_root/models/trees/unsloth.env"

# Unsloth's QAT UD-Q4_K_XL, one file, 14.2 GB: experts 408 MiB per layer (12.0 GiB), the rest 1.3 GiB.
: "${MODEL_REPO:=unsloth/gemma-4-26B-A4B-it-qat-GGUF}"
: "${MODEL_REV:=7b92b5b28818151e8669af2e45e88d6086f490dd}"
: "${MODEL_FILE:=gemma-4-26B-A4B-it-qat-UD-Q4_K_XL.gguf}"
: "${MODEL_SHA256:=a7c5bc715f5ff8e99a3e8901ce7d2b42b402c669bf24f7c5250747633d0f5891}"
: "${MODEL_ALIAS:=gemma-4-26b-a4b}"
# The MTP drafter from the same revision, a 0.25 GB Q4_0 sharing the target's KV cache.
: "${DRAFT_FILE:=mtp-gemma-4-26B-A4B-it.gguf}"
: "${DRAFT_SHA256:=7272d97595f0d4c74bd7b623492b7dbdaafd8b7c72f329a8270ba4eca68f768a}"
: "${DRAFT_DISK_MB:=241}"
# The vision projector (VISION), from the same revision: F16, as for Qwen3.6.
: "${MMPROJ_FILE:=mmproj-F16.gguf}"
: "${MMPROJ_SHA256:=d00f211a7d4f7fb19bd9b75d8e9342eccffb5920b08fd9562167560fdfcc5dd1}"
MMPROJ_DISK_MB=1140
MMPROJ_RAM_MB=1400
# What it holds in RAM while serving: VmRSS 14 346 MB at gemma4-26b's CPU_MOE (2026-11-07,
# runs/T-082-gemma4-opt/ram.sh), 12 548 MB of it file-backed, nearly all the mapped GGUF. Not
# counted: llama-server's host prompt cache (--cache-ram), which grows with long sessions.
: "${MODEL_DISK_MB:=13830}"
: "${MODEL_RAM_MB:=14500}"
: "${MODEL_RAM_FULL_MB:=0}"
MODEL_BACKENDS="cuda"
# How install.sh and preflight list it in the ramp (README.md#which-model); a configuration may set its own.
: "${MODEL_TITLE:=Gemma-4-26B-A4B}"
: "${MODEL_ROLE:=candidate}"
MODEL_DOC=""
# Not offered until a bench run has measured it.
MODEL_SUPPORT=unsupported

# q8_0/q8_0 as for the Qwen models, not measured against f16 for this cache.
: "${KV_K:=q8_0}"
: "${KV_V:=q8_0}"
# Empty: the template reads enable_thinking, not reasoning_effort.
: "${EFFORT:=}"
# The card's: the assistant drafts 4 tokens at a time, +44 % at 512 and +19-37 % at depth over
# none for ~1 GB of VRAM, one expert layer (run gemma4-opt-speed).
: "${SPEC_TYPE:=draft-mtp}"
: "${SERVER_ARGS:=--spec-draft-n-max 4}"

# The card's sampling (temperature 1.0, top-p 0.95, top-k 64).
: "${SAMPLING_TEMP:=1.0}"
: "${SAMPLING_TOP_P:=0.95}"
: "${SAMPLING_TOP_K:=64}"
: "${SAMPLING_MIN_P:=0.0}"
