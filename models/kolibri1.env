# SPDX-License-Identifier: MIT
# Kolibri-1, Aleph Alpha's 78B MoE (384 experts, 6 active, 3.5B per token, 50 layers), German and
# English: every routed expert in system RAM, attention, the shared expert and the KV cache on the
# card. From 64 GB of RAM, like Qwen3.8-Flash, at Qwen3.6's speed: 44 tok/s with every expert in
# RAM. No valid agent session yet. See docs/kolibri1.md.
# Sourced by config.env after the configuration, so a configuration value wins over the defaults here.

# No llama.cpp release knows the kolibri1 architecture (ggml-org/llama.cpp#29922). The GGUF's
# author ships a patch against mainline 836d571 (release b11381), applied by build from
# patches/kolibri1 on either backend. The release number goes in by hand: the shallow fetch counts
# one commit, and the build fetches the web UI by that number. See docs/kolibri1.md#the-tree.
: "${LLAMA_REPO:=https://github.com/ggml-org/llama.cpp}"
: "${LLAMA_COMMIT:=836d57176dc699a726c55418e4f96b8ca628e1bf}"
: "${LLAMA_DIR:=$LAS_HOME/llama.cpp-kolibri}"
: "${LLAMA_CMAKE_ARGS:=-DLLAMA_BUILD_NUMBER=11381}"
PATCH_DIR="patches/kolibri1"

# Q4_K_M, one file: routed experts 42.6 GiB, the rest 1.6 GiB. Converted from Aleph Alpha's FP8
# checkpoint, no imatrix; Q8_0 (83 GB) does not fit next to the card.
: "${MODEL_REPO:=Hob-forge/Kolibri-1-GGUF}"
: "${MODEL_REV:=b08405e141706457126fa75b9f2f9e0729b30d0a}"
: "${MODEL_FILE:=Kolibri-1-Q4_K_M.gguf}"
: "${MODEL_SHA256:=c2ac1301424441ef210b6de50ce25e8ccf69f86494df53d6ba52ed558456062e}"
: "${MODEL_ALIAS:=kolibri-1}"
# Text only: there is no projector, and VISION=1 is refused (config.env).
: "${MMPROJ_FILE:=}"
# The experts as page cache, 45.7 GB; MODEL_RAM_FULL_MB stays 0 until a run with less free RAM
# shows where the SSD starts to read. Measured on CUDA only.
: "${MODEL_DISK_MB:=45300}"
: "${MODEL_RAM_MB:=47000}"
: "${MODEL_RAM_FULL_MB:=0}"
MODEL_BACKENDS="cuda"
# How install.sh and preflight list it in the ramp (README.md#which-model); a configuration may set its own.
: "${MODEL_TITLE:=Kolibri-1 78B}"
: "${MODEL_ROLE:=German and English, ~44 tok/s}"
# Where its pin, settings and backends are explained; preflight names it.
MODEL_DOC="docs/kolibri1.md"
# Not offered by install.sh nor recommended by preflight until a bench run has measured it.
MODEL_SUPPORT=unsupported

: "${KV_K:=q8_0}"
: "${KV_V:=q8_0}"
# The template reads reasoning_effort: none, low, medium, high (its default). medium as for Bonsai
# and Qwen3.8-Flash, not measured for this model.
: "${EFFORT:=medium}"
# No MTP head, and no small model shares its tokenizer to draft with.
: "${SPEC_TYPE:=}"

# The model card's sampling, which the patch's author tested against.
: "${SAMPLING_TEMP:=1.0}"
: "${SAMPLING_TOP_P:=0.97}"
: "${SAMPLING_TOP_K:=128}"
: "${SAMPLING_MIN_P:=0.0}"
