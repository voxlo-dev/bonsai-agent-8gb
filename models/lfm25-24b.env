# SPDX-License-Identifier: MIT
# LFM2.5-24B-A2B, Liquid AI's reasoning MoE (architecture lfm2moe: 40 layers, 10 of them attention,
# the rest short convolutions; 64 experts, 4 active, 2B per token), text only. The experts of
# CPU_MOE layers in system RAM, the rest on the card; with 10 attention layers the KV cache stays
# small at its full 131k window. The first architecture no shipped model runs (T-079), a candidate
# to replace Bonsai. Not yet benched or tuned: bench-optimize, then its campaign row.
# Sourced by config.env after the configuration, so a configuration value wins over the defaults here.

# On CUDA Unsloth's tree, already built for both Qwen models: it knows lfm2moe and parses LFM2's
# Pythonic tool calls (common/parsers/lfm2.cpp). Its patch reaches only Qwen3.8-Flash's sparse
# attention. Not measured on Vulkan.
. "$_root/models/trees/unsloth.env"

# Q4_K_XL, one file, 14.9 GB.
: "${MODEL_REPO:=unsloth/LFM2.5-24B-A2B-GGUF}"
: "${MODEL_REV:=aacc77834f6aa568c93b4dbd6d295059736be98c}"
: "${MODEL_FILE:=LFM2.5-24B-A2B-UD-Q4_K_XL.gguf}"
: "${MODEL_SHA256:=a235d23638cc5549cb1ff61da7522c8a7e97f056f27093462a1e56f35aba91d8}"
: "${MODEL_ALIAS:=lfm2.5-24b-a2b}"
# Text only: there is no projector, and VISION=1 is refused (config.env).
: "${MMPROJ_FILE:=}"
# The file plus page cache for the experts in RAM; estimated from the file, not measured.
: "${MODEL_DISK_MB:=14200}"
: "${MODEL_RAM_MB:=16000}"
: "${MODEL_RAM_FULL_MB:=0}"
MODEL_BACKENDS="cuda"
# How install.sh and preflight list it among the models (README.md#which-model).
MODEL_TITLE="LFM2.5-24B-A2B"
MODEL_ROLE="reasoning agent, 2B active"
# Where its pin and settings are explained; preflight names it.
MODEL_DOC="docs/lfm25.md"
# Not offered by install.sh until a bench run has measured it.
MODEL_SUPPORT=unsupported

# q8_0/q8_0 as for the Qwen models, not measured against f16 for this cache.
: "${KV_K:=q8_0}"
: "${KV_V:=q8_0}"
# Empty: the template has no reasoning_effort; the model always thinks.
: "${EFFORT:=}"
# No MTP head, and no small model drafts with its tokenizer here.
: "${SPEC_TYPE:=}"

# The model card's sampling (temperature 0.1, top-k 50, repetition penalty 1.05; no top-p).
: "${SAMPLING_TEMP:=0.1}"
: "${SAMPLING_TOP_P:=1.0}"
: "${SAMPLING_TOP_K:=50}"
: "${SAMPLING_MIN_P:=0.0}"
: "${SERVER_ARGS:=--repeat-penalty 1.05}"
