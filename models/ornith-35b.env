# SPDX-License-Identifier: MIT
# Ornith-1.5-35B-A3B, Deep Reinforce's self-improved coding agent on Qwen3.6-35B-A3B's architecture
# (qwen35moe: 40 layers, every fourth attention, the rest gated delta-net; 256 experts, 8 active,
# ~3B per token; one MTP layer). The experts of CPU_MOE layers in system RAM, attention, shared
# expert, KV cache and the MTP head on the card, as for Qwen3.6. Offered at 32 GB beside Qwen3.6: the
# better agent with less thinking and the only one to pass the hallucination tasks, the weaker chat
# assistant (docs/bench.md#ornith-15-35b-in-tier-2). See docs/ornith.md.
# Sourced by config.env after the configuration, so a configuration value wins over the defaults here.

# Qwen3.6's architecture, so Qwen3.6's tree on CUDA (models/trees/unsloth.env), already built and
# measured with it and its MTP drafting. Not measured on Vulkan.
. "$_root/models/trees/unsloth.env"

# Ornith's own Q4_K_M, one file, 21.7 GB: experts 466 MiB per layer (18.7 GiB), the rest 1.6 GiB,
# a gigabyte less than Qwen3.6's UD-Q4_K_XL keeps on the card.
: "${MODEL_REPO:=ornith-ai/Ornith-1.5-35B-A3B-GGUF}"
: "${MODEL_REV:=12393612fd4f730ff5aadc23e9b8f9648aa49ceb}"
: "${MODEL_FILE:=Ornith-1.5-35B-Q4_K_M.gguf}"
: "${MODEL_SHA256:=42739874cc2ccfdb8523b23fbe52e29b2a7555c8176737ca9ca0b5d59859d41f}"
: "${MODEL_ALIAS:=ornith-1.5-35b-a3b}"
# Its own projector, from the same revision; BF16 is the only one published.
: "${MMPROJ_FILE:=mmproj-Ornith-1.5-35B-BF16.gguf}"
: "${MMPROJ_SHA256:=1921a36a85aee56cd2abd27f46701802c9d85a33474792e600df6c3b282a135d}"
MMPROJ_DISK_MB=870
MMPROJ_RAM_MB=1100
# What it holds in RAM while serving: VmRSS 20 285 MB at ornith-35b's CPU_MOE (2026-11-07,
# runs/T-082-ornith-opt/ram.sh), 18 370 MB of it file-backed, nearly all the mapped GGUF; rounded up, so 32 GB of RAM passes
# preflight. Not counted: llama-server's host prompt cache (--cache-ram), which grows with long sessions.
: "${MODEL_DISK_MB:=20710}"
: "${MODEL_RAM_MB:=21000}"
: "${MODEL_RAM_FULL_MB:=0}"
MODEL_BACKENDS="cuda"
# How install.sh and preflight list it in the ramp (README.md#which-model); a configuration may set its own.
: "${MODEL_TITLE:=Ornith-1.5-35B-A3B}"
: "${MODEL_ROLE:=lean agent, ~55 tok/s, weaker chat}"
# Where its pin and settings are explained; preflight names it.
MODEL_DOC="docs/ornith.md"
# Offered by install.sh, never recommended (RAMP_ALSO): a bench run has measured it.
MODEL_SUPPORT=supported

# q8_0/q8_0 as Qwen3.6, whose cache this is (docs/context-window.md#kv-cache-quality); not measured
# for these weights.
: "${KV_K:=q8_0}"
: "${KV_V:=q8_0}"
# Empty: the GGUF's template reads enable_thinking, not reasoning_effort. It renders every
# reasoning block it is given; --no-reasoning-preserve still drops those before the last user message.
: "${EFFORT:=}"
: "${SPEC_TYPE:=draft-mtp}"

# The card's sampling for its agent benchmarks (SWE-Bench, DeepSWE: temperature 1.0, top-p 0.95)
# with the GGUF's top-k 20; 0.6 is its advice for general tasks.
: "${SAMPLING_TEMP:=1.0}"
: "${SAMPLING_TOP_P:=0.95}"
: "${SAMPLING_TOP_K:=20}"
: "${SAMPLING_MIN_P:=0.0}"
