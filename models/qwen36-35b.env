# SPDX-License-Identifier: MIT
# Qwen3.6-35B-A3B, a MoE with 3B active parameters: the experts of CPU_MOE layers in system RAM,
# attention, shared expert, KV cache and the MTP head on the card. The default, and the
# recommendation from 32 GB of RAM: the best agent sessions so far (docs/agent-sessions.md). Needs
# ~28 GB RAM; measured on CUDA and, for speed only, on the RX 570. See docs/qwen36.md.
# Sourced by config.env after the configuration, so a configuration value wins over the defaults here.

# Not the fork: it runs this model as fast but cannot draft with its MTP layer, which is worth
# +33-54 % on natural output. On CUDA, Unsloth's tree, the one Qwen3.8-Flash needs, from the file both
# source (models/trees/unsloth.env), since they share its build dir. Measured equal to
# mainline 8212c78 to 0.5 %, the same drafts accepted, the same VRAM (T-038). On Vulkan mainline,
# where Qwen3.6 was measured and Unsloth's tree was not. Unsloth's tree carries Flash's patch
# (patches/unsloth/), which only Flash's sparse attention reaches; mainline has none.
if [ "$BACKEND" = cuda ]; then
  . "$_root/models/trees/unsloth.env"
else
  : "${LLAMA_REPO:=https://github.com/ggml-org/llama.cpp}"
  : "${LLAMA_COMMIT:=8212c7802455255460ab8e18fc34754560031b34}"
  : "${LLAMA_DIR:=$LAS_HOME/llama.cpp-mainline}"
  PATCH_DIR=""
fi

# The -MTP- repo: the same weights as unsloth/Qwen3.6-35B-A3B-GGUF plus one MTP layer. UD-Q4_K_XL,
# benched in tier 1 (docs/bench.md); the -display and -vulkan configurations keep the UD-Q4_K_M
# they were measured with.
: "${MODEL_REPO:=unsloth/Qwen3.6-35B-A3B-MTP-GGUF}"
: "${MODEL_REV:=5bc3e238d916f48a861bac2f8a1990a0e9b7e98d}"
: "${MODEL_FILE:=Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf}"
: "${MODEL_SHA256:=55983c5a75a1ab969824077b3bb3de4146e82a9234072b48ad4e8f92ad3fe9f1}"
: "${MODEL_ALIAS:=qwen3.6-35b-a3b}"
# The vision projector (VISION), from the same revision: F16 and BF16 encode equally fast on the
# CPU, F16 is the smaller. Size and RAM for preflight. See docs/qwen36.md#vision.
: "${MMPROJ_FILE:=mmproj-F16.gguf}"
: "${MMPROJ_SHA256:=71f3cbc1f7cc0f30d09d41cfa924c0060827ebc33bf15ace7e86661e856f0160}"
MMPROJ_DISK_MB=860
MMPROJ_RAM_MB=1100
# RSS 20-23.5 GB while serving, most of it the mmapped experts as page cache; preflight asks for
# this plus ~2 GB in total, which a 28 GB machine (27.4 GB MemTotal) passes. Vulkan is measured on
# the RX 570, with configs/qwen36-35b-vulkan.env: docs/qwen36.md#on-the-rx-570-vulkan.
: "${MODEL_DISK_MB:=21800}"
: "${MODEL_RAM_MB:=25100}"
: "${MODEL_RAM_FULL_MB:=0}"
MODEL_BACKENDS="cuda vulkan"
# How install.sh and preflight list it in the ramp (README.md#which-model); a configuration may set its own.
: "${MODEL_TITLE:=Qwen3.6-35B-A3B}"
: "${MODEL_ROLE:=the coding agent, ~50 tok/s}"
# Where its pin, settings and backends are explained; preflight names it.
MODEL_DOC="docs/qwen36.md"
# Offered by install.sh and recommended by preflight: a bench run has measured it.
MODEL_SUPPORT=supported

# q8_0/q8_0: this cache is 3-33x more sensitive than Bonsai's, and V at q4_0 degrades with depth.
# See docs/context-window.md#kv-cache-quality.
: "${KV_K:=q8_0}"
: "${KV_V:=q8_0}"
# Empty: the template reads enable_thinking, not reasoning_effort, so the flag is not passed.
: "${EFFORT:=}"
# The MTP layer drafts, 63-80 % accepted at the default draft length 3. ~1.66 GB of VRAM,
# already paid for in the configuration's CPU_MOE and UB.
: "${SPEC_TYPE:=draft-mtp}"

# Sampling: Bonsai's recommended values, which Qwen used for its own agent benchmarks.
: "${SAMPLING_TEMP:=1.0}"
: "${SAMPLING_TOP_P:=0.95}"
: "${SAMPLING_TOP_K:=20}"
: "${SAMPLING_MIN_P:=0.0}"
